{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UI.SH Viewer",
  "version": "0.0.0",
  "identifier": "io.github.ironcherep.uishviewer",
  "build": {
    "beforeDevCommand": "pnpm dev:app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UI.SH Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
